{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "lib/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "@tiny/host-core-wasm#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "pkg/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../host-core/src/**",
        "../host-core/Cargo.toml",
        "../../Cargo.toml",
        "../../Cargo.lock"
      ]
    },
    "@tiny/host-web-components#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "src/generated/**"
      ]
    }
  }
}
