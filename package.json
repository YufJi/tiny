{
  "name": "tiny-v1",
  "version": "1.0.0",
  "description": "\u5c0f\u7a0b\u5e8f\u5f15\u64ce",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "watch": "turbo run watch",
    "compile:glass-easel": "node scripts/compile-glass-easel.mjs",
    "compile:devtool": "node scripts/compile-mini.mjs example/glass-easel/mini packages/devtool/static/runtime/apps/demo/generated",
    "compile:devtool:real": "node scripts/compile-mini.mjs example/mini packages/devtool/static/runtime/apps/real/generated",
    "compile:devtool:all": "pnpm compile:devtool && pnpm compile:devtool:real",
    "dev:glass-easel": "pnpm compile:glass-easel && pnpm --filter @tiny/compiler-next exec vite --config ../../example/glass-easel/vite.config.ts",
    "dev:devtool": "node scripts/dev-devtool.mjs",
    "accept:glass-easel": "node scripts/accept-glass-easel.mjs",
    "build:glass-easel": "pnpm --filter @tiny/stylesheet-compiler --filter @tiny/template-compiler --filter @tiny/bridge --filter @tiny/builtin-components --filter @tiny/compiler-next --filter @tiny/runtime build",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "playwright-core": "^1.64.1",
    "turbo": "^2.0.0",
    "typescript": "^4.5.2"
  },
  "packageManager": "pnpm@9.10.0"
}
