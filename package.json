{
  "name": "tiny-v1",
  "version": "1.0.0",
  "description": "小程序引擎",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "watch": "turbo run watch",
    "compile:glass-easel": "node scripts/compile-glass-easel.mjs",
    "dev:glass-easel": "pnpm compile:glass-easel && pnpm --filter @tiny/compiler-next exec vite --config ../../example/glass-easel/vite.config.ts",
    "accept:glass-easel": "node scripts/accept-glass-easel.mjs",
    "build:glass-easel": "pnpm --filter @tiny/stylesheet-compiler --filter @tiny/template-compiler --filter @tiny/bridge --filter @tiny/builtin-components --filter @tiny/compiler-next --filter @tiny/runtime build",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "turbo": "^2.0.0",
    "typescript": "^4.5.2"
  },
  "packageManager": "pnpm@9.10.0"
}
