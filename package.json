{
  "name": "tiny",
  "version": "0.1.0",
  "description": "A miniprogram framework that based on glass-easel",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "watch": "turbo run watch",
    "compile:glass-easel": "node scripts/compile-glass-easel.mjs",
    "compile:devtool": "node scripts/compile-devtool-apps.mjs",
    "compile:devtool:all": "pnpm compile:devtool",
    "dev:glass-easel": "pnpm compile:glass-easel && pnpm --filter @tiny/cli exec vite --config ../../tests/host/vite.config.ts",
    "dev:devtool": "node scripts/dev-devtool.mjs",
    "accept:glass-easel": "node scripts/accept-glass-easel.mjs",
    "build:glass-easel": "pnpm --filter @tiny/css-units --filter @tiny/manifest --filter @tiny/wxs-runtime --filter @tiny/stylesheet-compiler --filter @tiny/template-compiler --filter @tiny/bridge --filter @tiny/cli --filter @tiny/runtime --filter @tiny/host-web-components --filter @tiny/host-browser build",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "site:dev": "pnpm site:devtool && pnpm --filter @tiny/website dev",
    "site:devtool": "node scripts/build-site-devtool.mjs",
    "site:check": "pnpm site:build && node scripts/check-website.mjs",
    "site:build": "pnpm site:devtool && pnpm --filter @tiny/website build",
    "site:preview": "pnpm --filter @tiny/website preview",
    "compile:wechat-demo": "node scripts/compile-mini.mjs tests/apps/wechat-demo tests/host/generated",
    "parity:probe": "node scripts/parity-probe.mjs",
    "dev:wechat-demo": "pnpm compile:wechat-demo && pnpm --filter @tiny/cli exec vite --config ../../tests/host/vite.config.ts --port 5174",
    "check:runtime-purity": "node scripts/check-runtime-purity.mjs"
  },
  "author": "YufJi",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "playwright-core": "^1.64.1",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22"
  }
}
