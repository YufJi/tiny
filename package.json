{
  "name": "tiny",
  "version": "0.1.0",
  "description": "A miniprogram framework that based on glass-easel",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "watch": "turbo run watch",
    "compile:glass-easel": "node scripts/compile-glass-easel.mjs",
    "compile:devtool": "node scripts/compile-mini.mjs tests/apps/demo apps/devtool/static/runtime/apps/demo/generated",
    "compile:devtool:real": "node scripts/compile-mini.mjs tests/apps/mini apps/devtool/static/runtime/apps/real/generated",
    "compile:devtool:all": "pnpm compile:devtool && pnpm compile:devtool:real",
    "dev:glass-easel": "pnpm compile:glass-easel && pnpm --filter @tiny/cli exec vite --config ../../tests/host/vite.config.ts",
    "dev:devtool": "node scripts/dev-devtool.mjs",
    "accept:glass-easel": "node scripts/accept-glass-easel.mjs",
    "build:glass-easel": "pnpm --filter @tiny/manifest --filter @tiny/stylesheet-compiler --filter @tiny/template-compiler --filter @tiny/bridge --filter @tiny/components --filter @tiny/cli --filter @tiny/runtime build",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "site:dev": "node scripts/serve-website.mjs",
    "site:check": "node scripts/check-website.mjs"
  },
  "author": "YufJi",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "playwright-core": "^1.64.1",
    "turbo": "^2.0.0",
    "typescript": "^4.5.2"
  },
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22"
  }
}
