{
  "name": "@tiny/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tiny architecture site (GitHub Pages)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && TINY_SSR=1 vite build --ssr src/entry-server.jsx --outDir .cache/ssr --emptyOutDir && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "build:client": "vite build"
  },
  "dependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "vite": "^5.4.21",
    "yaml": "^2.9.1"
  }
}
