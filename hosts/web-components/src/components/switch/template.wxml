<div class="tiny-switch-wrapper">
  <div
    id="switchInput"
    class="tiny-switch-input {{checked ? 'tiny-switch-input-checked' : ''}} {{disabled ? 'tiny-switch-input-disabled' : ''}}"
    type="checkbox"
    hidden="{{type === 'checkbox'}}"
    style="background-color: {{switchColor}}; border-color: {{switchColor}};"
  ></div>
  <div
    id="checkboxInput"
    class="tiny-checkbox-input {{checked ? 'tiny-checkbox-input-checked' : ''}} {{disabled ? 'tiny-checkbox-input-disabled' : ''}}"
    type="checkbox"
    hidden="{{type !== 'checkbox'}}"
    style="color: {{color}};"
  ></div>
</div>
