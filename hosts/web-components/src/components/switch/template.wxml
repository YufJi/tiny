<label class="tiny-switch-wrapper {{disabled ? 'is-disabled' : ''}}">
  <input
    id="native-input"
    class="tiny-switch-native"
    aria-label="{{ariaLabel}}"
    type="checkbox"
    checked="{{checked}}"
    disabled="{{disabled}}"
    catchchange="handleChange"
  />
  <span
    class="tiny-switch-input {{checked ? 'is-checked' : ''}} {{disabled ? 'is-disabled' : ''}}"
    style="--tiny-switch-color: {{color}};"
  ></span>
</label>
