<div
  class="tiny-swiper {{vertical ? 'is-vertical' : ''}}"
  style="padding-left: {{previousMargin}}; padding-right: {{nextMargin}}; --tiny-swiper-items: {{displayMultipleItems}};"
  aria-label="{{ariaLabel}}"
  bindtouchstart="handleTouchStart"
  bindtouchend="handleTouchEnd"
>
  <div class="tiny-swiper-wrapper">
    <div class="tiny-swiper-slides">
      <div class="tiny-swiper-track tiny-swiper-slide-frame" style="{{trackStyle}}"><slot /></div>
    </div>
  </div>
  <div class="tiny-swiper-dots" hidden="{{!indicatorDots}}">
    <div
      wx:for="{{dots}}"
      wx:key="*this"
      id="tiny-swiper-dot-{{item}}"
      class="tiny-swiper-dot {{item === activeIndex ? 'is-active' : ''}}"
      style="background-color: {{item === activeIndex ? (indicatorActiveColor || '') : (indicatorColor || '')}};"
      catchtap="handleDotTap"
    ></div>
  </div>
</div>
