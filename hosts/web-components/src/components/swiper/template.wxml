<div
  id="slidesWrapper"
  class="tiny-swiper-wrapper"
  role="listbox"
  aria-label="{{ariaLabel}}"
>
  <div id="slides" class="tiny-swiper-slides" style="{{slidesStyle}}">
    <div id="slideFrame" class="tiny-swiper-slide-frame" style="{{trackStyle}}"><slot /></div>
  </div>
  <div
    id="slidesDots"
    class="tiny-swiper-dots {{vertical ? 'is-vertical' : 'is-horizontal'}}"
    hidden="{{!indicatorDots}}"
  >
    <div
      wx:for="{{dots}}"
      wx:key="index"
      class="tiny-swiper-dot {{item.active ? 'is-active' : ''}}"
      style="background-color: {{item.active ? (indicatorActiveColor || '') : (indicatorColor || '')}};"
      catchtap="handleDotTap"
      data-index="{{item.index}}"
    ></div>
  </div>
</div>
