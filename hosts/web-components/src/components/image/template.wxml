<div
  id="div"
  class="tiny-image-div"
  role="img"
  aria-label="{{ariaLabel}}"
  style="{{imageStyle}}"
>
  <block wx:if="{{resolvedSrc && (!lazyLoad || inViewport)}}">
    <img
      wx:if="{{useImg}}"
      class="tiny-image-img"
      src="{{resolvedSrc}}"
      alt=""
      loading="{{lazyLoad ? 'lazy' : 'eager'}}"
      bindload="handleLoad"
      binderror="handleError"
    />
    <img
      wx:else
      class="tiny-image-probe"
      src="{{resolvedSrc}}"
      alt=""
      loading="{{lazyLoad ? 'lazy' : 'eager'}}"
      bindload="handleLoad"
      binderror="handleError"
    />
  </block>
</div>
<span><slot /></span>
