<div
  class="tiny-progress-bar"
  role="progressbar"
  aria-label="{{ariaLabel}}"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="{{curPercent}}"
  style="height: {{strokeWidth}}px; background-color: {{backgroundColor}}; border-radius: {{borderRadius}}px;"
>
  <div
    class="tiny-progress-inner-bar {{active ? 'is-active' : ''}}"
    style="width: {{curPercent}}%; background-color: {{activeColor || color}}; border-radius: {{borderRadius}}px;"
    bindtransitionend="handleActiveEnd"
  />
</div>
<span
  wx:if="{{showInfo}}"
  class="tiny-progress-info"
  style="font-size: {{fontSize}}px; color: {{color}};"
>{{curPercent}}%</span>
