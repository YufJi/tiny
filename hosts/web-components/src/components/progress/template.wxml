<div
  class="tiny-progress-bar"
  style="height: {{barHeight}}; background-color: {{backgroundColor}}; border-radius: {{barRadius}};"
>
  <div
    class="tiny-progress-inner-bar"
    style="width: {{curPercent}}%; background-color: {{activeBarColor}};"
  />
</div>
<p class="tiny-progress-info" hidden="{{!showInfo}}" style="font-size: {{infoFontSize}};">{{curPercent}}%</p>
