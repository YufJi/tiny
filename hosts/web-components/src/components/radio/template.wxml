<label class="tiny-radio-wrapper">
  <input
    id="native-input"
    class="tiny-radio-native"
    aria-label="{{ariaLabel}}"
    type="radio"
    value="{{value}}"
    checked="{{checked}}"
    disabled="{{disabled}}"
    catchchange="handleChange"
  />
  <div
    class="tiny-radio-input {{checked ? 'is-checked' : ''}} {{disabled ? 'is-disabled' : ''}}"
    style="--tiny-radio-color: {{color}};"
  ></div>
  <slot />
</label>
