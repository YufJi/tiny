<div id="wrap" class="tiny-scroll-view {{enableFlex ? 'tiny-scroll-view-flex' : ''}}">
  <div
    id="main"
    style="position: relative; z-index: 1; overflow-x: hidden; overflow-y: hidden;"
    class="tiny-scroll-view {{enableFlex ? 'tiny-scroll-view-flex' : ''}} {{scrollX ? 'is-horizontal' : ''}} {{enhanced && !showScrollbar ? 'is-hidden-scrollbar' : ''}} {{enhanced && pagingEnabled ? 'is-paging' : ''}}"
    bindscroll="handleScroll"
    bindtouchstart="handleTouchStart"
    bindtouchmove="handleTouchMove"
    bindtouchend="handleTouchEnd"
    bindtouchcancel="handleTouchCancel"
  >
    <refresher-impl
      wx:if="{{refresherEnabled}}"
      id="refresher"
      default-style="{{refresherDefaultStyle}}"
      threshold="{{refresherThreshold}}"
      background="{{refresherBackground}}"
      triggered="{{refresherTriggered}}"
      enable-passive="{{enablePassive}}"
      bindpulling="handleRefresherPulling"
      bindrefresh="handleRefresherRefresh"
      bindrestore="handleRefresherRestore"
      bindabort="handleRefresherAbort"
    ><slot name="refresher" /></refresher-impl>
    <div id="content" class="tiny-scroll-view-content"><slot /></div>
  </div>
  <div id="barWrap" class="tiny-wins-scrollbar" style="display: none;">
    <div id="scrollbar" class="tiny-wins-scrollbar-bar"></div>
  </div>
</div>
