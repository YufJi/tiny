<div id="wrap" class="tiny-scroll-view {{enableFlex ? 'tiny-scroll-view-flex' : ''}}">
  <div
    id="main"
    class="tiny-scroll-view {{enableFlex ? 'tiny-scroll-view-flex' : ''}} {{scrollX ? 'is-horizontal' : ''}} {{scrollY ? 'is-vertical' : ''}} {{showScrollbar ? '' : 'is-hidden-scrollbar'}} {{bounces ? '' : 'is-no-bounce'}} {{pagingEnabled ? 'is-paging' : ''}} {{scrollAnchoring ? 'is-anchoring' : ''}}"
    bindscroll="handleScroll"
    bindtap="handleTap"
    bindtouchstart="handleTouchStart"
    bindtouchmove="handleTouchMove"
    bindtouchend="handleTouchEnd"
    bindtouchcancel="handleTouchCancel"
  >
    <slot name="refresher" />
    <div id="content" class="tiny-scroll-view-content"><slot /></div>
  </div>
  <div id="barWrap" class="tiny-wins-scrollbar" style="display: none;">
    <div id="scrollbar" class="tiny-wins-scrollbar-bar"></div>
  </div>
</div>
