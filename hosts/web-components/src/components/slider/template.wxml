<div class="tiny-slider-wrapper {{disabled ? 'tiny-slider-disabled' : ''}}">
  <div id="wrapper" class="tiny-slider-tap-area">
    <div
      class="tiny-slider-handle-wrapper"
      style="background-color: {{backgroundValue}};"
    >
      <div id="handle" class="tiny-slider-handle" style="left: {{valuePercent}};"></div>
      <div
        class="tiny-slider-thumb"
        style="left: {{valuePercent}}; width: {{thumbSize}}px; height: {{thumbSize}}px; margin-left: {{thumbOffset}}px; margin-top: {{thumbOffset}}px; background-color: {{blockColor}};"
      ></div>
      <div
        class="tiny-slider-track"
        style="width: {{valuePercent}}; background-color: {{activeValue}};"
      ></div>
      <div id="step" class="tiny-slider-step"></div>
    </div>
  </div>
  <span class="tiny-slider-value" hidden="{{!showValue}}">
    <p style="width: {{valueTextWidth}};">{{filteredValue}}</p>
  </span>
</div>
