{
  "name": "@tiny/host-web-components",
  "version": "0.1.0",
  "description": "Web/DOM implementations of the Tiny mini-program built-in components (host package, not runtime core)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "templates": "node scripts/build-templates.mjs",
    "prebuild": "node scripts/build-templates.mjs && node scripts/build-styles.mjs",
    "build": "vite build && tsc -p tsconfig.build.json",
    "pretypecheck": "node scripts/build-templates.mjs && node scripts/build-styles.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build-templates.mjs && node scripts/build-styles.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "styles": "node scripts/build-styles.mjs"
  },
  "dependencies": {
    "@tiny/css-units": "workspace:*",
    "@tiny/engine-naming": "workspace:*",
    "@tiny/manifest": "workspace:*",
    "@tiny/runtime": "workspace:*",
    "glass-easel": "1.1.0"
  },
  "devDependencies": {
    "@tiny/stylesheet-compiler": "workspace:*",
    "@tiny/template-compiler": "workspace:*",
    "@types/node": "^22.0.0",
    "postcss": "^8.4.38",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
