.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx;
}

.card {
  padding: 48rpx;
  border: 1px solid rgba(148, 163, 184, 0.35);
  border-radius: 24rpx;
  background: #17223b;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
}

.subtitle {
  display: block;
  margin-top: 16rpx;
  color: #94a3b8;
  font-size: 28rpx;
}
