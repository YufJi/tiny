{
  "name": "@tiny/template-compiler",
  "version": "1.0.0",
  "description": "Glass-easel template compiler Node.js implementation - WXML to JavaScript code generator",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "template-compiler",
    "wxml",
    "miniprogram",
    "glass-easel"
  ],
  "dependencies": {
    
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
