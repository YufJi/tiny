{
  "name": "@tiny/manifest",
  "version": "0.1.0",
  "description": "Versioned mini-program artifact and manifest contract",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prebuild": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
