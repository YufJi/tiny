<view class="tiny-swiper {{vertical ? 'is-vertical' : ''}} class" style="{{style}}" bindtouchstart="handleTouchStart" bindtouchend="handleTouchEnd"><view class="tiny-swiper-track" style="{{trackStyle}}"><slot /></view><view class="tiny-swiper-dots" hidden="{{!indicatorDots}}"><view wx:for="{{dots}}" wx:key="*this" id="tiny-swiper-dot-{{item}}" class="tiny-swiper-dot {{item === activeIndex ? 'is-active' : ''}}" catchtap="handleDotTap"></view></view></view>