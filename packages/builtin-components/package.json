{
  "name": "@tiny/builtin-components",
  "version": "0.1.0",
  "description": "Glass-easel implementations of the Tiny P0 built-in components",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "templates": "node scripts/build-templates.mjs",
    "prebuild": "node scripts/build-templates.mjs",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "glass-easel": "1.1.0"
  },
  "devDependencies": {
    "@tiny/template-compiler": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
