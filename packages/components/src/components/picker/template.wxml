<div
  class="tiny-picker__wrapper"
  role="button"
  aria-label="{{ariaLabel}}"
  bindtap="handleOpen"
>
  <slot />
</div>
<div wx:if="{{overlayVisible}}" class="tiny-picker__overlay">
  <div class="tiny-picker__backdrop" catchtap="handleCancel"></div>
  <div class="tiny-picker__panel">
    <div class="tiny-picker__toolbar">
      <span class="tiny-picker__cancel" catchtap="handleCancel">取消</span>
      <span class="tiny-picker__title">{{overlayTitle}}</span>
      <span class="tiny-picker__confirm" catchtap="handleConfirm">确定</span>
    </div>
    <picker-view
      class="tiny-picker__view"
      value="{{draftValue}}"
      indicator-style="height: 34px;"
      bindchange="handleOverlayChange"
    >
      <picker-view-column
        wx:for="{{overlayColumns}}"
        wx:for-item="column"
        wx:for-index="columnIndex"
      >
        <div
          wx:for="{{column}}"
          wx:for-item="option"
          wx:key="value"
          class="tiny-picker__option"
        >{{option.label}}</div>
      </picker-view-column>
    </picker-view>
  </div>
</div>
