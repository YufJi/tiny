<div id="wrapper" class="tiny-picker__wrapper" role="button" aria-label="{{ariaLabel}}">
  <slot />
  <select
    id="native-picker"
    wx:if="{{mode === 'selector'}}"
    class="tiny-picker__native"
    value="{{value}}"
    disabled="{{disabled}}"
    catchchange="handleSelectorChange"
  >
    <option
      wx:for="{{options}}"
      wx:key="value"
      value="{{item.value}}"
      selected="{{item.value === value}}"
    >{{item.label}}</option>
  </select>
  <input
    id="native-picker"
    wx:elif="{{mode === 'date'}}"
    class="tiny-picker__native"
    type="date"
    value="{{value}}"
    start="{{start}}"
    end="{{end}}"
    disabled="{{disabled}}"
    catchchange="handleDateChange"
  />
  <input
    id="native-picker"
    wx:elif="{{mode === 'time'}}"
    class="tiny-picker__native"
    type="time"
    value="{{value}}"
    disabled="{{disabled}}"
    catchchange="handleDateChange"
  />
  <input
    id="native-picker"
    wx:else
    class="tiny-picker__native"
    type="text"
    value="{{value}}"
    disabled="{{disabled}}"
    catchchange="handleDateChange"
  />
</div>
