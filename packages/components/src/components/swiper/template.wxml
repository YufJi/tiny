<view
  class="tiny-swiper {{vertical ? 'is-vertical' : ''}} {{hidden ? 'tiny-hidden' : ''}} class"
  style="{{style}} padding-left: {{previousMargin}}; padding-right: {{nextMargin}}; --tiny-swiper-items: {{displayMultipleItems}};"
  aria-label="{{ariaLabel}}"
  bindtouchstart="handleTouchStart"
  bindtouchend="handleTouchEnd"
>
  <view class="tiny-swiper-track" style="{{trackStyle}}"><slot /></view>
  <view class="tiny-swiper-dots" hidden="{{!indicatorDots}}">
    <view
      wx:for="{{dots}}"
      wx:key="*this"
      id="tiny-swiper-dot-{{item}}"
      class="tiny-swiper-dot {{item === activeIndex ? 'is-active' : ''}}"
      style="background-color: {{item === activeIndex ? (indicatorActiveColor || '') : (indicatorColor || '')}};"
      catchtap="handleDotTap"
    ></view>
  </view>
</view>
