<input
  id="native-input"
  class="tiny-input {{placeholderClass}}"
  value="{{value}}"
  placeholder="{{placeholder}}"
  disabled="{{disabled}}"
  type="{{password ? 'password' : type}}"
  maxlength="{{maxlength}}"
  autofocus="{{autoFocus || focus}}"
  enterkeyhint="{{confirmType}}"
  aria-label="{{ariaLabel}}"
  catchinput="handleInput"
  catchchange="handleChange"
  catchfocus="handleFocus"
  catchblur="handleBlur"
  catchkeydown="handleKeyDown"
  catchcompositionstart="handleCompositionStart"
  catchcompositionupdate="handleCompositionUpdate"
  catchcompositionend="handleCompositionEnd"
  catchselect="handleSelect"
/>
