<input
  id="native-input"
  class="tiny-input {{hidden ? 'tiny-hidden' : ''}} class {{placeholderClass}}"
  style="{{style}}"
  value="{{value}}"
  placeholder="{{placeholder}}"
  disabled="{{disabled}}"
  type="{{password ? 'password' : type}}"
  maxlength="{{maxlength}}"
  autofocus="{{autoFocus || focus}}"
  enterkeyhint="{{confirmType}}"
  aria-label="{{ariaLabel}}"
  catchinput="handleInput"
  catchchange="handleChange"
  catchfocus="handleFocus"
  catchblur="handleBlur"
  catchkeydown="handleKeyDown"
/>
