<wxs module="t" src="./wxs-runtime.wxs"></wxs>
<wxs module="counter" src="./counter.wxs"></wxs>
<view class="page">
  <text class="title">WXS runtime</text>
  <text class="status">status: {{status}}</text>
  <view class="probe-wrap" bind:probe="onProbeJs">
    <wxs-probe
      id="probe"
      label="{{value}}"
      change:label="{{t.observeProbe}}"
      bind:probe="{{t.onProbe}}"
    />
  </view>
  <text class="probe-js-count">probe-js-count: {{probeJsCount}}</text>
  <view
    id="target"
    class="target"
    data-kind="box"
    data-value="{{value}}"
    prop="{{value}}"
    change:prop="{{t.observe}}"
    bindtap="{{t.tap}}"
  ></view>
  <view id="dynamic" class="dynamic" data-kind="dyn" data-value="{{value}}" bindtap="{{useWxs ? t.dynamicTap : 'serviceTap'}}">dynamic</view>
  <text class="dynamic-status">dynamic-status: {{dynamicStatus}}</text>
  <button bindtap="toggleUseWxs">Toggle dynamic handler</button>
  <button bindtap="bumpValue">Bump value</button>
  <slider value="{{value}}" bindchange="{{t.changed}}" />
  <view id="bubble-parent" class="event-parent" bindtap="onParentTap">
    <view id="bubble-child" class="event-child" bindtap="{{t.childTap}}">bubble</view>
  </view>
  <text class="child-status">child-status: {{childStatus}}</text>
  <text class="parent-status">parent-status: {{parentStatus}}</text>
  <view id="stop-parent" class="event-parent" bindtap="onStopParentTap">
    <view id="stop-child" class="event-child" catchtap="{{t.stopTap}}">stop</view>
  </view>
  <text class="stop-status">stop-status: {{stopStatus}}</text>
  <text class="stop-parent-status">stop-parent-status: {{stopParentStatus}}</text>
  <view id="capture-parent" class="event-parent" capture-bind:tap="{{t.captureParent}}">
    <view id="capture-child" class="event-child" capture-bind:tap="{{t.captureChild}}">capture</view>
  </view>
  <text class="capture-status">capture-status: {{captureStatus}}</text>
  <text class="capture-parent-status">capture-parent-status: {{captureParentStatus}}</text>
  <view id="mut-outer" mut-bind:tap="{{t.mutOuter}}">
    <view id="mut-inner" class="event-child" mut-bind:tap="{{t.mutInner}}">mut-bind</view>
    <view id="mut-normal-parent" bindtap="onMutNormalParent">
      <view id="mut-normal-child" class="event-child" mut-bind:tap="{{t.mutNormalChild}}">mut-normal</view>
    </view>
  </view>
  <text class="mut-status">mut-status: {{mutStatus}}</text>
  <view id="target-outer" class="event-parent" data-role="outer" bindtap="onTargetProbe">
    <view id="target-inner" class="event-child" data-role="inner">target</view>
  </view>
  <text class="target-status">target-status: {{targetStatus}}</text>
  <trait-probe />
  <trait-relation-parent>
    <trait-relation-child />
  </trait-relation-parent>
  <view id="counter" class="event-child" bindtap="{{useCounter ? counter.hit : 'serviceCounter'}}">counter</view>
  <text class="counter-status">counter-status: {{counterStatus}}</text>
  <text class="state-status">state-status: {{stateStatus}}</text>
  <text class="computed-status">computed-status: {{computedStatus}}</text>
  <button bindtap="toggleCounterHandler">Toggle counter handler</button>
  <button bindtap="back">Back</button>
</view>
