function tap(event, ins) {
  var data = ins.getData()
  ins.callMethod('record', 'tap:' + data.value + ':' + event.currentTarget.dataset.kind)
  ins.selectComponent('#target').setStyle({ left: '12px' })
}

function changed(event, ins) {
  ins.callMethod('record', 'change:' + event.detail.value)
}

function observe(next, previous, ins) {
  ins.callMethod('record', 'observe:' + next + ':' + (previous === undefined ? 'none' : previous))
}

module.exports = {
  tap: tap,
  changed: changed,
  observe: observe,
}
