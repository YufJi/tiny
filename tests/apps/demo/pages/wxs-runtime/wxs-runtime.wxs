function tap(event, ins) {
  ins.callMethod('record', 'tap:' + ins.getDataset().value + ':' + event.currentTarget.dataset.kind)
  ins.selectComponent('#target').setStyle({ left: '12px', width: '75rpx' })
  var state = ins.getState()
  state.count = (state.count || 0) + 1
  ins.callMethod('recordState', 'state:' + state.count)
  var computed = ins.selectComponent('#target').getComputedStyle(['width'])
  ins.callMethod('recordComputed', 'computed:' + computed.width)
}

function changed(event, ins) {
  ins.callMethod('record', 'change:' + event.detail.value)
}

function dynamicTap(event, ins) {
  ins.callMethod('recordDynamic', 'wxs:' + ins.getDataset().value)
}

function childTap(event, ins) {
  ins.callMethod('recordChild', 'child')
}

function stopTap(event, ins) {
  ins.callMethod('recordStop', 'stop')
  return false
}

function captureChild(event, ins) {
  ins.callMethod('recordCapture', 'capture')
}

function captureParent(event, ins) {
  ins.callMethod('recordCaptureParent', 'capture-parent')
}

function observe(next, previous, ins) {
  var state = ins.getState()
  state.builtinObserved = true
  ins.callMethod('record', 'observe:' + next + ':' + (previous === undefined ? 'none' : previous) + ':state=' + typeof state)
}

function observeProbe(next, previous, ins) {
  // `getState` only exists on the view-side descriptor. A service-side
  // observer would throw here instead of recording.
  var state = ins.getState()
  state.observed = (state.observed || 0) + 1
  var computed = ins.getComputedStyle(['width'])
  ins.callMethod('record', 'observe-probe:' + next + ':' + (previous === undefined ? 'none' : previous) + ':' + state.observed + ':computed=' + (computed && typeof computed.width))
}

function onProbe(event, ins) {
  var state = ins.getState()
  state.probeCalls = (state.probeCalls || 0) + 1
  var target = ins.selectComponent('#probe')
  if (target) target.setStyle({ width: '123px' })
  ins.callMethod('record', 'probe-event:' + event.detail.value + ':' + (state.observed || 0) + ':call=' + state.probeCalls)
}

module.exports = {
  tap: tap,
  dynamicTap: dynamicTap,
  changed: changed,
  childTap: childTap,
  stopTap: stopTap,
  captureChild: captureChild,
  captureParent: captureParent,
  observe: observe,
  observeProbe: observeProbe,
  onProbe: onProbe,
}
